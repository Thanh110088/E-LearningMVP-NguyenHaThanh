generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum AuthProvider {
  LOCAL   // đăng ký bằng email + mật khẩu
  GOOGLE  // tài khoản tạo từ Google (password có thể null)
}

enum EmailTokenType {
  VERIFY_EMAIL     // link kích hoạt tài khoản sau đăng ký
  RESET_PASSWORD   // link quên mật khẩu
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String?        // null nếu chỉ login Google, chưa đặt mật khẩu
  fullName          String
  avatarUrl         String?
  googleId          String?        @unique // "sub" Google trả về, dùng để nhận diện lần sau
  provider          AuthProvider   @default(LOCAL)
  emailVerified     Boolean        @default(false) // false → chưa được login password
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?
  role              RoleName       @default(STUDENT)
  plan              UserPlan       @default(FREE)
  planExpiresAt     DateTime?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  createdExams  Exam[]         @relation("CreatedExams")
  submissions   Submission[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  workspaces    Workspace[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]

  @@map("users")
}

// Mỗi lần login/refresh tạo 1 hàng. Logout / đổi MK đánh dấu revokedAt.
// Chỉ lưu tokenHash, không lưu JWT gốc.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime? // null = còn dùng được
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Token trong email: user nhận raw token, DB chỉ có hash.
model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  tokenHash String         @unique
  type      EmailTokenType
  expiresAt DateTime
  usedAt    DateTime?      // khác null = đã dùng 1 lần, không dùng lại
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  @default("#06b6d4")
  icon        String?  @default("FolderKanban")
  isDefault   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exams       Exam[]
  questions   Question[]

  @@map("workspaces")
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams       Exam[]

  @@map("subjects")
}

model Grade {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams       Exam[]

  @@map("grades")
}

model Exam {
  id               String       @id @default(uuid())
  title            String
  description      String?
  code             String       @unique
  thumbnailUrl     String?
  durationMinutes  Int          @default(45)
  totalPoints      Float        @default(10.0)
  passPoints       Float        @default(5.0)
  status           ExamStatus   @default(DRAFT)
  isLive           Boolean      @default(false)
  pinCode          String?

  // === PHÒNG THI CÓ KIỂM SOÁT ===
  startTime        DateTime?    // Thời điểm mở phòng thi
  endTime          DateTime?    // Thời điểm đóng phòng thi
  examPassword     String?      // Mật khẩu vào phòng thi (null = không yêu cầu)
  shuffleQuestions Boolean      @default(false) // Trộn thứ tự câu hỏi
  shuffleOptions   Boolean      @default(false) // Trộn thứ tự đáp án
  maxAttempts      Int          @default(1)     // Số lần thi tối đa (0 = không giới hạn)
  showAnswerAfter  Boolean      @default(false) // Cho xem đáp án sau khi nộp bài
  proctorEnabled   Boolean      @default(false) // Bật chế độ giám sát (fullscreen enforcement)

  subjectId        String
  gradeId          String
  createdById      String
  workspaceId      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  subject          Subject      @relation(fields: [subjectId], references: [id])
  grade            Grade        @relation(fields: [gradeId], references: [id])
  createdBy        User         @relation("CreatedExams", fields: [createdById], references: [id])
  workspace        Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  questions        Question[]
  submissions      Submission[]

  @@map("exams")
}

model Question {
  id          String       @id @default(uuid())
  content     String
  type        QuestionType @default(SINGLE_CHOICE)
  points      Float        @default(1.0)
  difficulty  Difficulty   @default(MEDIUM)
  explanation String?
  imageUrl    String?
  examId      String?
  subjectId   String?
  workspaceId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  exam        Exam?        @relation(fields: [examId], references: [id], onDelete: Cascade)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  options     Option[]

  @@map("questions")
}

model Option {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model Submission {
  id          String           @id @default(uuid())
  examId      String
  userId      String
  score          Float            @default(0.0)
  isPassed       Boolean          @default(false)
  status         SubmissionStatus @default(IN_PROGRESS)
  startedAt      DateTime         @default(now())
  submittedAt    DateTime?
  answersJson    Json?
  violations     Json?            // Mảng {type, timestamp} ghi lại vi phạm chi tiết
  questionOrder  Json?            // Thứ tự câu hỏi sau khi trộn đề (array of questionId)

  exam        Exam             @relation(fields: [examId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@map("submissions")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String
  plan          UserPlan
  amount        Float              @default(0.0)
  paymentMethod String             @default("QR_BANKING")
  status        SubscriptionStatus @default(ACTIVE)
  startedAt     DateTime           @default(now())
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
