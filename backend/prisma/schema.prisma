generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  fullName      String
  avatarUrl     String?
  role          RoleName       @default(STUDENT)
  plan          UserPlan       @default(FREE)
  planExpiresAt DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdExams  Exam[]         @relation("CreatedExams")
  submissions   Submission[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  workspaces    Workspace[]

  @@map("users")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  @default("#06b6d4")
  icon        String?  @default("FolderKanban")
  isDefault   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exams       Exam[]
  questions   Question[]

  @@map("workspaces")
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams       Exam[]

  @@map("subjects")
}

model Grade {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams       Exam[]

  @@map("grades")
}

model Exam {
  id              String       @id @default(uuid())
  title           String
  description     String?
  code            String       @unique
  thumbnailUrl    String?
  durationMinutes Int          @default(45)
  totalPoints     Float        @default(10.0)
  passPoints      Float        @default(5.0)
  status          ExamStatus   @default(DRAFT)
  isLive          Boolean      @default(false)
  pinCode         String?
  subjectId       String
  gradeId         String
  createdById     String
  workspaceId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subject         Subject      @relation(fields: [subjectId], references: [id])
  grade           Grade        @relation(fields: [gradeId], references: [id])
  createdBy       User         @relation("CreatedExams", fields: [createdById], references: [id])
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  questions       Question[]
  submissions     Submission[]

  @@map("exams")
}

model Question {
  id          String       @id @default(uuid())
  content     String
  type        QuestionType @default(SINGLE_CHOICE)
  points      Float        @default(1.0)
  difficulty  Difficulty   @default(MEDIUM)
  explanation String?
  imageUrl    String?
  examId      String?
  subjectId   String?
  workspaceId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  exam        Exam?        @relation(fields: [examId], references: [id], onDelete: Cascade)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  options     Option[]

  @@map("questions")
}

model Option {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model Submission {
  id          String           @id @default(uuid())
  examId      String
  userId      String
  score       Float            @default(0.0)
  isPassed    Boolean          @default(false)
  status      SubmissionStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  answersJson Json?

  exam        Exam             @relation(fields: [examId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@map("submissions")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String
  plan          UserPlan
  amount        Float              @default(0.0)
  paymentMethod String             @default("QR_BANKING")
  status        SubscriptionStatus @default(ACTIVE)
  startedAt     DateTime           @default(now())
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
